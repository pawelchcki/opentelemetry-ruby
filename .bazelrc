# Keep fork source and test results local, even with user-level remote defaults.
common --remote_executor=
common --remote_cache=
common --bes_backend=
common --spawn_strategy=sandboxed,local
test --test_output=errors

# Optional execution on the user's BuildBuddy workers.
common:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
common:buildbuddy --bes_results_url=https://pawel.buildbuddy.io/invocation/
common:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_executor=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_timeout=10m
common:buildbuddy --remote_download_outputs=minimal
common:buildbuddy --remote_local_fallback=false
common:buildbuddy --remote_upload_local_results=false
common:buildbuddy --spawn_strategy=remote
common:buildbuddy --jobs=100
common:buildbuddy --extra_execution_platforms=@rules_stests//bazel/platforms:rbe_linux_amd64
common:buildbuddy --host_platform=@rules_stests//bazel/platforms:rbe_linux_amd64
common:buildbuddy --@@rules_python+//python/config_settings:bootstrap_impl=script
